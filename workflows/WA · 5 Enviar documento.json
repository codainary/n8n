      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT $1::text AS wa_id, chatbot.config('wa_phone_number_id') AS phone_number_id,\n       COALESCE((SELECT can_send_free_form FROM chatbot.window_state($1)), false) AS can_send_free_form",
