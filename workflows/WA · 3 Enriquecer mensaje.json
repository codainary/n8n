      "notes": "Why Code: OpenAI detecta el formato por la extensión del archivo y Meta entrega el audio sin nombre. Ningún nodo nativo renombra metadatos de un binario sin re-leerlo.",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1420,
        300
      ],
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  item.binary.data.fileName = 'nota.ogg';\n  item.binary.data.fileExtension = 'ogg';\n}\nreturn $input.all();"
      }
