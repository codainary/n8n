    {
      "id": "i7",
      "name": "Fragmentar",
      "notes": "Why Code: estrategia de fragmentación propia que ningún nodo nativo cubre como items: FAQ = 1 fila por fragmento con id estable; Docs = 1 sección (##) por fragmento; PDF/secciones largas = ventanas de ~3200 caracteres con 400 de solapamiento.",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        200
      ],
      "parameters": {
        "jsCode": "// Estrategia:\n//  - Sheet con columnas pregunta/respuesta (FAQ): 1 fila = 1 fragmento, id = fileId#<id de la fila>\n//  - Otros Sheets: 1 fila = 1 fragmento (\"columna: valor\")\n//  - Google Docs (markdown) y PDF: 1 sección (## Título) = 1 fragmento; si es larga, ventanas\n//    de ~3200 caracteres (~800 tokens) con 400 de solapamiento, cortando por párrafos.\n// Cada fragmento lleva \"Documento › Sección\" al inicio para que se entienda solo.\nconst f = $('Entrada').first().json;\nconst raw = String($json.content || '');\nconst MAX = 3200, OVERLAP = 400;\nconst chunks = [];\nconst title = String(f.name).replace(/\\s*·\\s*Automaverso\\s*$/i, '').trim();\n\nfunction windows(text) {\n  const paras = text.split(/\\n{2,}/).map(p => p.trim()).filter(Boolean);\n  const out = []; let cur = '';\n  for (const p of paras) {\n    if (cur && (cur.length + p.length + 2) > MAX) { out.push(cur); cur = cur.slice(-OVERLAP) + '\\n\\n' + p; }\n    else cur = cur ? cur + '\\n\\n' + p : p;\n    while (cur.length > MAX * 1.5) { out.push(cur.slice(0, MAX)); cur = cur.slice(MAX - OVERLAP); }\n  }\n  if (cur.trim()) out.push(cur);\n  return out;\n}\nfunction parseCsv(s) {\n  const rows = []; let row = [], fld = '', q = false;\n  for (let i = 0; i < s.length; i++) {\n    const c = s[i];\n    if (q) { if (c === '\"' && s[i + 1] === '\"') { fld += '\"'; i++; } else if (c === '\"') q = false; else fld += c; }\n    else if (c === '\"') q = true;\n    else if (c === ',') { row.push(fld); fld = ''; }\n    else if (c === '\\n' || c === '\\r') { if (c === '\\r' && s[i + 1] === '\\n') i++; row.push(fld); rows.push(row); row = []; fld = ''; }\n    else fld += c;\n  }\n  if (fld || row.length) { row.push(fld); rows.push(row); }\n  return rows;\n}\n\nif (f.mime_type === 'application/vnd.google-apps.spreadsheet') {\n  const rows = parseCsv(raw);\n  const head = (rows.shift() || []).map(h => h.trim().toLowerCase());\n  const col = n => head.indexOf(n);\n  const isFaq = col('pregunta') >= 0 && col('respuesta') >= 0;\n  rows.forEach((r, i) => {\n    const get = n => (col(n) >= 0 ? String(r[col(n)] || '').trim() : '');\n    if (isFaq) {\n      const p = get('pregunta'), a = get('respuesta');\n      if (!p || !a) return;\n      if (get('activo').toUpperCase() === 'FALSE') return;\n      const id = get('id') || `fila-${i + 2}`;\n      const kw = get('palabras_clave');\n      chunks.push({ id: `${f.file_id}#${id}`, section: get('categoria'), doc_type: 'faq',\n        text: `Pregunta: ${p}\\nRespuesta: ${a}` + (kw ? `\\nPalabras clave: ${kw}` : ''),\n        extra: { faq_id: id, pregunta: p, fuente: get('fuente') } });\n    } else {\n      const line = head.map((h, j) => (r[j] && String(r[j]).trim() ? `${h}: ${String(r[j]).trim()}` : '')).filter(Boolean).join('\\n');\n      if (line) chunks.push({ id: `${f.file_id}#r${String(i + 2).padStart(4, '0')}`, section: title, doc_type: 'hoja', text: `${title}\\n${line}` });\n    }\n  });\n} else {\n  const docType = f.mime_type === 'application/pdf' ? 'pdf' : 'documento';\n  const text = raw\n    .replace(/\\*\\*/g, '')\n    .replace(/\\\\([\\\\`*_{}\\[\\]()#+\\-.!:|>])/g, '$1')\n    .split('\\n')\n    .filter(l => !/^\\s*\\|?\\s*:?-{3,}/.test(l) && l.trim() !== '---')\n    .map(l => (/^\\s*\\|.*\\|\\s*$/.test(l) ? l.split('|').map(x => x.trim()).filter(Boolean).join(': ') : l))\n    .join('\\n');\n  const parts = []; let cur = { h: '', body: [] };\n  for (const l of text.split('\\n')) {\n    const m = l.match(/^#{1,3}\\s+(.*)/);\n    if (m) { if (cur.h || cur.body.join('').trim()) parts.push(cur); cur = { h: m[1].trim(), body: [] }; }\n    else cur.body.push(l);\n  }\n  parts.push(cur);\n  let n = 0;\n  for (const p of parts) {\n    const body = p.body.join('\\n').replace(/\\n{3,}/g, '\\n\\n').trim();\n    if (!body) continue;\n    const sec = p.h && p.h !== title ? p.h : 'Introducción';\n    for (const w of windows(body)) {\n      chunks.push({ id: `${f.file_id}#${String(n++).padStart(4, '0')}`, section: sec, doc_type: docType, text: `${title} › ${sec}\\n\\n${w}` });\n    }\n  }\n}\nreturn [{ json: { chunks, count: chunks.length, ids: chunks.map(c => c.id) } }];"
      }
    },
