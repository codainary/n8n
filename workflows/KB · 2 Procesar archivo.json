    {
      "id": "i10",
      "name": "Armar vectores",
      "notes": "Why Code: emparejar cada embedding con su fragmento y metadatos, y partir en lotes de 100 (límite recomendado de upsert de Pinecone). Ningún nodo nativo hace el zip por índice + lotes.",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2020,
        120
      ],
      "parameters": {
        "jsCode": "const f = $('Entrada').first().json;\nconst chunks = $('Fragmentar').first().json.chunks;\nconst emb = [...$json.data].sort((a, b) => a.index - b.index);\nif (emb.length !== chunks.length) throw new Error(`Embeddings (${emb.length}) != fragmentos (${chunks.length})`);\nconst vectors = chunks.map((c, i) => {\n  const md = { file_id: f.file_id, file_name: f.name, category: f.category, doc_type: c.doc_type,\n    modified_time: f.modified_time, version: String(f.version), chunk_index: i, section: c.section, text: c.text, ...(c.extra || {}) };\n  for (const k of Object.keys(md)) if (md[k] === '' || md[k] === null || md[k] === undefined) delete md[k];\n  return { id: c.id, values: emb[i].embedding, metadata: md };\n});\nconst out = [];\nfor (let i = 0; i < vectors.length; i += 100) out.push({ json: { namespace: f.category, vectors: vectors.slice(i, i + 100) } });\nreturn out;"
      }
    },
