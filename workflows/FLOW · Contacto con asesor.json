{
  "name": "FLOW · Contacto con asesor",
  "nodes": [
    {
      "id": "h1",
      "name": "Entrada",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        300
      ],
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            {
              "name": "wa_id",
              "type": "string"
            },
            {
              "name": "text",
              "type": "string"
            },
            {
              "name": "action",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "h2",
      "name": "Paso (SQL)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        220,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "postgres": {
          "id": "aV6poYyo4OBcJu8E",
          "name": "Postgres VPS (chatbot)"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT s.*, $1::text AS wa_id, chatbot.config('wa_phone_number_id') AS phone_number_id,\n       chatbot.config('telegram_leads_chat_id') AS telegram_chat_id,\n       (SELECT diagnosis_id FROM chatbot.diagnoses WHERE wa_id = $1 AND diagnosis_id IS NOT NULL ORDER BY completed_at DESC NULLS LAST LIMIT 1) AS last_diagnosis_id\n  FROM (SELECT 1) x LEFT JOIN LATERAL chatbot.handoff_step($1, $2, $3) s ON true",
        "options": {
          "queryReplacement": "={{ [ $json.wa_id, $json.text || '', $json.action || 'continue' ] }}"
        }
      }
    },
    {
      "id": "h3",
      "name": "Tipo de respuesta",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "renameOutput": true,
              "outputKey": "text",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "rtext",
                    "leftValue": "={{ $json.reply?.type }}",
                    "rightValue": "text",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "renameOutput": true,
              "outputKey": "buttons",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "rbuttons",
                    "leftValue": "={{ $json.reply?.type }}",
                    "rightValue": "buttons",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "sin solicitud"
        }
      }
    },
    {
      "id": "h4",
      "name": "Enviar texto",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        180
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "30aSXJ9QwShLDa9s",
          "name": "WhatsApp Graph API (Bearer)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v23.0/{{ $('Paso (SQL)').first().json.phone_number_id }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', recipient_type: 'individual', to: $('Paso (SQL)').first().json.wa_id, type: 'text', text: { preview_url: false, body: $('Paso (SQL)').first().json.reply.body } }) }}",
        "options": {}
      }
    },
    {
      "id": "h5",
      "name": "Enviar botones",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        360
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "30aSXJ9QwShLDa9s",
          "name": "WhatsApp Graph API (Bearer)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v23.0/{{ $('Paso (SQL)').first().json.phone_number_id }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', recipient_type: 'individual', to: $('Paso (SQL)').first().json.wa_id, type: 'interactive', interactive: { type: 'button', body: { text: $('Paso (SQL)').first().json.reply.body }, action: { buttons: $('Paso (SQL)').first().json.reply.buttons.map(b => ({ type: 'reply', reply: { id: b.id, title: b.title } })) } } }) }}",
        "options": {}
      }
    },
    {
      "id": "h6",
      "name": "Registrar respuesta (SQL)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        900,
        260
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "postgres": {
          "id": "aV6poYyo4OBcJu8E",
          "name": "Postgres VPS (chatbot)"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT r.* FROM chatbot.register_outbound(jsonb_build_object(\n  'wamid', $1, 'wa_id', $2, 'type', $3, 'text', $4, 'agent_text', $5)) r",
        "options": {
          "queryReplacement": "={{ [ $json.messages[0].id, $('Paso (SQL)').first().json.wa_id, $('Paso (SQL)').first().json.reply.type === 'buttons' ? 'interactive' : 'text', $('Paso (SQL)').first().json.reply.body, $('Paso (SQL)').first().json.reply.body + ($('Paso (SQL)').first().json.reply.type === 'buttons' ? '\\n[Botones: ' + $('Paso (SQL)').first().json.reply.buttons.map(b => b.title).join(' | ') + ']' : '') ] }}"
        }
      }
    },
    {
      "id": "h7",
      "name": "¿Solicitud completa?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1120,
        260
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "h7c",
              "leftValue": "={{ $('Paso (SQL)').first().json.done === true }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "h8",
      "name": "Respuesta: paso enviado",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1340,
        420
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "h8a",
              "name": "response",
              "type": "string",
              "value": "ENVIADO: el usuario ya recibió el siguiente paso de la solicitud de asesor. No agregues texto."
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "h9",
      "name": "Respuesta: sin solicitud",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        680,
        560
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "h9a",
              "name": "response",
              "type": "string",
              "value": "SIN_SOLICITUD"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "h10",
      "name": "Conversación (SQL)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1340,
        160
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "postgres": {
          "id": "aV6poYyo4OBcJu8E",
          "name": "Postgres VPS (chatbot)"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT string_agg(CASE role WHEN 'user' THEN 'Cliente: ' ELSE 'Asistente: ' END || content, E'\\n' ORDER BY at) AS transcript\n  FROM chatbot.agent_context($1, 40)",
        "options": {
          "queryReplacement": "={{ [ $('Paso (SQL)').first().json.wa_id ] }}"
        }
      }
    },
    {
      "id": "h11",
      "name": "Resumir conversación (OpenAI)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        160
      ],
      "credentials": {
        "openAiApi": {
          "id": "sevrRORNVNDEXyvj",
          "name": "OpenAI (chatbot)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'gpt-4.1-mini', temperature: 0.2, max_tokens: 200, messages: [ { role: 'system', content: \"Resume en español, en 2 o 3 frases cortas, la conversación de WhatsApp entre un posible cliente y el asistente de Automaverso (automatización con IA). Incluye qué necesita o le interesa al cliente, su negocio o sector si lo mencionó, y si vio ejemplos. No inventes datos ni incluyas saludos. Si no hay información útil, di que solo pidió hablar con un asesor.\" }, { role: 'user', content: $json.transcript || '' } ] }) }}",
        "options": {}
      }
    },
    {
      "id": "h12",
      "name": "Registrar en Twenty",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
