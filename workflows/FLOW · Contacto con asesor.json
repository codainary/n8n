      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT chatbot.handoff_notified($1::int, $2, NULLIF($3, '')::int, $4, $5, NULLIF($6, '')::bigint, $7) AS ok",
        "options": {
          "queryReplacement": "={{ [ $('Paso (SQL)').first().json.handoff_id, $('Registrar en Twenty').first().json.leadId || '', '', $('Paso (SQL)').first().json.last_diagnosis_id || '', ($('Resumir conversación (OpenAI)').first().json.choices?.[0]?.message?.content?.trim() || ''), String($json.result?.message_id || $json.message_id || ''), ($json.result?.message_id || $json.message_id) ? '' : JSON.stringify($json.error || $json).slice(0, 500) ] }}"
        }
      }
    },
