    {
      "id": "h17",
      "name": "Avisar en Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        2000,
        160
      ],
      "credentials": {
        "telegramApi": {
          "id": "T2kzKYa0lIBPkI9c",
          "name": "Telegram Leads (automaversosas_bot)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput",
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $('Paso (SQL)').first().json.telegram_chat_id }}",
        "text": "={{ [\n  '🔔 <b>Nuevo lead desde WhatsApp</b>',\n  '',\n  '👤 <b>Nombre:</b> ' + String($('Paso (SQL)').first().json.name || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'),\n  '📞 <b>Prefiere:</b> ' + $('Paso (SQL)').first().json.channel_label,\n  '📱 <b>Teléfono:</b> ' + $('Paso (SQL)').first().json.phone_pretty,\n  '🧾 <b>Diagnóstico:</b> ' + ($('Paso (SQL)').first().json.last_diagnosis_id ? '✅ Sí (' + String($('Paso (SQL)').first().json.last_diagnosis_id || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;') + ')' : '❌ No'),\n  '🆔 <b>Lead:</b> ' + ($('Registrar en Twenty').first().json.leadId ? $('Registrar en Twenty').first().json.leadId + ($('Registrar en Twenty').first().json.isNewPerson ? ' (nuevo)' : ' (existente)') : '⚠️ no se pudo registrar en el CRM'),\n  '',\n  '📝 <b>Resumen</b>',\n  String(($('Resumir conversación (OpenAI)').first().json.choices?.[0]?.message?.content?.trim() || '') || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'),\n  '',\n  '☎️ Llamar: +' + $('Paso (SQL)').first().json.phone\n].join('\\n') }}",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  {
                    "text": "💬 Abrir chat de WhatsApp",
                    "additionalFields": {
                      "url": "=https://wa.me/{{ $('Paso (SQL)').first().json.wa_id }}"
                    }
                  }
                ]
              }
            },
            {
              "row": {
