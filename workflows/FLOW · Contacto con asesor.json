            "contact_channel": "={{ $('Paso (SQL)').first().json.channel }}",
            "contact_phone": "={{ $('Paso (SQL)').first().json.phone || $('Paso (SQL)').first().json.wa_id }}",
            "note_title": "Solicitud de asesor (WhatsApp)",
            "note": "={{ [ '**Pidió hablar con un asesor por WhatsApp**', '', '- Nombre: ' + ($('Paso (SQL)').first().json.name || '—'), '- Prefiere: ' + $('Paso (SQL)').first().json.channel_label + ' al ' + $('Paso (SQL)').first().json.phone_pretty, '- Diagnóstico: ' + ($('Paso (SQL)').first().json.last_diagnosis_id || 'no hizo'), '', '**Resumen de la conversación**', '', ($('Resumir conversación (OpenAI)').first().json.choices?.[0]?.message?.content?.trim() || '') || '—' ].join('\\n') }}",
            "diag": "={{ null }}"
          },
          "matchingColumns": [],
