                  {
                    "text": "📇 Ver en el CRM",
                    "additionalFields": {
                      "url": "={{ $('Registrar en Twenty').first().json.opportunityUrl || 'https://crm.automaverso.com' }}"
                    }
                  }
                ]
              }
            }
          ]
        },
