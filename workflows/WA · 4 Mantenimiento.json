        "operation": "executeQuery",
        "query": "WITH closed AS (SELECT chatbot.close_expired_conversations() AS n),\nexhausted AS (\n  UPDATE chatbot.messages\n     SET processing_state = 'failed', processed_at = now(),\n         error = COALESCE(error, '{\"reason\":\"max_attempts\"}'::jsonb)\n   WHERE direction = 'in' AND processing_state = 'processing'\n     AND processing_attempts >= 3 AND processing_started_at < now() - interval '5 minutes'\n  RETURNING 1)\nSELECT (SELECT n FROM closed) AS conversations_closed, (SELECT count(*)::int FROM exhausted) AS messages_failed",
