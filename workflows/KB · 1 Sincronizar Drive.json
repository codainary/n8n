      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT p.file_id, p.name, p.mime_type, p.category, p.modified_time, p.version::text AS version, p.action,\n       p.old_category, to_jsonb(COALESCE(p.old_vector_ids, '{}')) AS old_ids\n  FROM kb.plan_sync($1::bigint,\n       COALESCE((SELECT jsonb_agg(jsonb_build_object(\n                   'file_id', f->>'id', 'name', f->>'name', 'mime_type', f->>'mimeType',\n                   'category', c->>'category', 'modified_time', f->>'modifiedTime', 'version', f->>'version'))\n                   FROM jsonb_array_elements($2::jsonb) c\n                   CROSS JOIN LATERAL jsonb_array_elements(COALESCE(c->'files', '[]'::jsonb)) f), '[]'::jsonb),\n       $3::boolean) p",
        "options": {
          "queryReplacement": "={{ [ $('Abrir ejecución (SQL)').first().json.run_id, JSON.stringify($('Listar archivos (Drive)').all().map((it, i) => ({ category: $('Ignorar carpetas «_»').all()[i].json.name, files: it.json.files || [] }))), $('Abrir ejecución (SQL)').first().json.full ] }}"
        }
      },
