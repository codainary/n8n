    {
      "parameters": {
        "jsCode": "// Capturamos la salida del Agente\nconst rawOutput = items[0].json.output;\n\n// 1. Extraer el estado (ej: BUSCANDO_PRODUCTO)\nconst estadoMatch = rawOutput.match(/ESTADO_CONTROL:\\s*\\[?(\\w+)\\]?/);\nconst nuevoEstado = estadoMatch ? estadoMatch[1] : 'INICIO';\n\n// 2. Limpiar el texto para WhatsApp (quitamos la etiqueta técnica)\nconst textoLimpio = rawOutput.replace(/ESTADO_CONTROL:\\s*\\[?\\w+\\]?/, '').trim();\n\n// 3. Preparar el objeto JSON para la base de datos (para que no de error JSONB)\n// Aquí puedes extraer datos si quieres, por ahora mandamos un objeto vacío válido\nconst datosJSON = {}; \n\nreturn {\n  mensaje_final: textoLimpio,\n  estado_db: nuevoEstado,\n  datos_db: datosJSON, // Esto es un objeto, Postgres lo aceptará\n  wa_id: $node[\"WhatsApp Trigger\"].json.contacts[0].wa_id\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1072,
        688
      ],
      "id": "daf64550-8f36-4548-af00-29028e033e49",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO waly_sessions (wa_id, estado_actual, datos_recolectados, ultima_interaccion)\nVALUES (\n  '{{ $json.wa_id }}', \n  '{{ $json.estado_db }}', \n  '{{ JSON.stringify($json.datos_db) }}'::jsonb, \n  NOW()\n)\nON CONFLICT (wa_id) \nDO UPDATE SET \n  estado_actual = EXCLUDED.estado_actual,\n  datos_recolectados = EXCLUDED.datos_recolectados,\n  ultima_interaccion = NOW();",
        "options": {}
      },
