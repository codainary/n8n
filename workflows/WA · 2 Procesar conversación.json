    {
      "id": "p5",
      "name": "Preparar contexto (SQL)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "executeOnce": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "position": [
        880,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT $1::text AS wa_id,\n       $2::text AS batch_id,\n       chatbot.config('wa_phone_number_id') AS phone_number_id,\n       chatbot.config('elevenlabs_voice_id') AS voice_id,\n       (SELECT string_agg(CASE role WHEN 'user' THEN 'Usuario: ' ELSE 'Asistente: ' END || content, E'\\n' ORDER BY at)\n          FROM chatbot.agent_context($1, 30)) AS transcript,\n       (SELECT msg_type FROM chatbot.messages WHERE batch_id = $2::uuid ORDER BY meta_timestamp DESC, id DESC LIMIT 1) AS last_type,\n       (SELECT bool_and(msg_type NOT IN ('text', 'audio', 'image', 'document')) FROM chatbot.messages WHERE batch_id = $2::uuid) AS only_unsupported,\n       (SELECT string_agg(COALESCE(agent_text, text_body, '[' || msg_type || ']'), E'\\n' ORDER BY meta_timestamp, id)\n          FROM chatbot.messages WHERE batch_id = $2::uuid) AS batch_text",
        "options": {
          "queryReplacement": "={{ [ $('Entrada').first().json.wa_id, $('Tomar ráfaga (SQL)').first().json.batch_id ] }}"
        }
