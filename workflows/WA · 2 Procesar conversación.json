    {
      "id": "p12",
      "name": "Nombrar respuesta .ogg",
      "notes": "Why Code: ElevenLabs devuelve audio/opus sin nombre; WhatsApp solo acepta notas de voz como audio/ogg (codec opus) y valida el mime del archivo subido. Ningún nodo nativo cambia los metadatos de un binario.",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2520,
        160
      ],
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  item.binary.data.mimeType = 'audio/ogg';\n  item.binary.data.fileName = 'respuesta.ogg';\n  item.binary.data.fileExtension = 'ogg';\n}\nreturn $input.all();"
      }
