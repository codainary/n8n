      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  item.binary.data.mimeType = 'audio/ogg';\n  item.binary.data.fileName = 'respuesta.ogg';\n  item.binary.data.fileExtension = 'ogg';\n}\nreturn $input.all();"
