        "query": "SELECT m.id::int AS message_id, m.wa_id, m.msg_type, COALESCE(m.text_body, '') AS text_body, COALESCE(m.caption, '') AS caption,\n       m.media_id::int AS media_id, COALESCE(md.meta_media_id, '') AS meta_media_id, COALESCE(md.mime_type, '') AS media_mime,\n       COALESCE(md.file_name, '') AS media_file_name, m.batch_id::text AS batch_id, m.meta_timestamp\n  FROM chatbot.claim_pending($1) m\n  LEFT JOIN chatbot.media md ON md.id = m.media_id\n ORDER BY m.meta_timestamp, m.id",
