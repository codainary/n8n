# .env de n8n en el VPS (/home/deploy/n8n/.env, permisos 600). Nunca al repo.

# Postgres propio de n8n (contraseña nueva, distinta a la local)
POSTGRES_USER=n8n
POSTGRES_PASSWORD=
POSTGRES_DB=n8n

# MISMA clave que el .env local: las credenciales guardadas se cifran con ella
N8N_ENCRYPTION_KEY=

# Token compartido main ↔ runner (openssl rand -hex 32)
N8N_RUNNERS_AUTH_TOKEN=

N8N_HOST=n8n.automaverso.com
N8N_USER_MANAGEMENT_JWT_DURATION_HOURS=168
TIMEZONE=America/Mexico_City
