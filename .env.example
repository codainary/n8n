# ==========================================
# n8n Environment Configuration
# ==========================================

# PostgreSQL Database
POSTGRES_USER=n8n_user
POSTGRES_PASSWORD=N8n_Secure_P@ssw0rd_2024!
POSTGRES_DB=n8n_db

# Redis
REDIS_PASSWORD=R3d1s_Secure_P@ss_2024!

# n8n Security (IMPORTANTE: No compartir esta clave)
N8N_ENCRYPTION_KEY=2anJAU04YPPLJ9JgZnJL59ISmKEFX/O8

# Session Configuration
# Tiempo de expiración de sesión (en horas) - 300h = 12.5 días
N8N_USER_MANAGEMENT_JWT_DURATION_HOURS=300

# n8n Configuration
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/
# Para exponer webhooks públicamente usa tu dominio/túnel, ej: https://n8n-dev.automaverso.com/

# Disable secure cookie for local development (HTTP)
N8N_SECURE_COOKIE=false

# Timezone (ajusta según tu ubicación)
TIMEZONE=America/Mexico_City

# n8n Public API (usada por n8n-mcp y scripts/n8n-sync.mjs)
# Crear en: Settings > n8n API > Create API key
N8N_API_URL=http://localhost:5678
N8N_API_KEY=

# Task runners (n8n 2.x) - token compartido main/workers/runners
# Generar con: openssl rand -hex 32
N8N_RUNNERS_AUTH_TOKEN=
