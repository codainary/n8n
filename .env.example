# ==========================================
# n8n Environment Configuration (EXAMPLE)
# Copy this file to .env and fill in your values
# ==========================================

# PostgreSQL Database
POSTGRES_USER=n8n_user
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=n8n_db

# Redis (Queue System)
REDIS_PASSWORD=your_secure_redis_password

# n8n Security
# IMPORTANTE: Genera una nueva clave para producción
# Comando: openssl rand -base64 32
# En PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
N8N_ENCRYPTION_KEY=your_encryption_key_here

# Session Configuration
# Tiempo de expiración de sesión (en horas)
# 168 = 7 días, 300 = 12.5 días, 720 = 30 días
N8N_USER_MANAGEMENT_JWT_DURATION_HOURS=168

# n8n Configuration
N8N_HOST=localhost
WEBHOOK_URL=https://your-domain.com

# Timezone
# Lista completa: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=America/Mexico_City
